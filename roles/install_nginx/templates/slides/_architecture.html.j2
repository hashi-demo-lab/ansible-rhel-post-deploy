<section class="slide slide--architecture" id="architecture">
  <div class="wrap" style="width: min(95%, 90rem)">
    <p class="section-label reveal">Under the hood</p>
    <h2 class="section-title reveal reveal-delay-1">How It All Connects</h2>
    <p class="arch-subtitle text-muted reveal reveal-delay-1" style="margin-bottom: var(--space-s); color: var(--text-faint); font-size: 0.95rem; min-height: 1.3em;">
      <span class="typed" id="archSubtitleTyped"></span>
    </p>

    <div class="reveal reveal-delay-2" style="display: flex; justify-content: center; position: relative; margin-top: 3.5rem;">
      <span class="arch-phase-label" id="archPhaseLabel"><span class="typed" id="archPhaseTyped"></span></span>
      <svg id="archSvg" viewBox="0 0 960 570" xmlns="http://www.w3.org/2000/svg" style="width: 100%; max-width: 960px; font-family: 'IBM Plex Sans', sans-serif;" class="arch-highlight-monitor">
        <defs>
          <marker id="arrowhead" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
            <polygon points="0 0, 8 3, 0 6" fill="oklch(45% 0.01 55)"/>
          </marker>
          <marker id="arrowGold" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
            <polygon points="0 0, 8 3, 0 6" fill="#B28600"/>
          </marker>
          <marker id="arrowRed" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
            <polygon points="0 0, 8 3, 0 6" fill="#EE0000"/>
          </marker>
          <marker id="arrowBlue" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
            <polygon points="0 0, 8 3, 0 6" fill="#0F62FE"/>
          </marker>
          <marker id="arrowGreen" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
            <polygon points="0 0, 8 3, 0 6" fill="#198038"/>
          </marker>
          <marker id="arrowTeal" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto">
            <polygon points="0 0, 8 3, 0 6" fill="#009D9A"/>
          </marker>
          <filter id="shadow" x="-4%" y="-4%" width="108%" height="108%">
            <feDropShadow dx="0" dy="2" stdDeviation="4" flood-opacity="0.08"/>
          </filter>
        </defs>

        <!-- ── Platform Zones (always visible) ── -->
        <!-- HCP Vault Zone -->
        <rect x="20" y="15" width="280" height="540" rx="16" fill="oklch(96% 0.015 80)" stroke="oklch(85% 0.02 80)" stroke-width="1.5"/>
        <!-- Vault icon (dark, above title) -->
        <g transform="translate(148, 22) scale(0.044)">
          <path d="M107.77 0 0 62.21 0 62.26 0 211.54 40.47 234.95 40.47 85.56 107.77 46.71 107.77 0Z" fill="oklch(35% 0.02 80)"/>
          <path d="M150.79 0 150.79 118.96 107.77 118.96 107.77 74.54 67.25 97.94 67.25 250.34 107.77 273.75 107.77 155.16 150.79 155.16 150.79 199.26 191.31 175.91 191.31 23.41 150.79 0Z" fill="oklch(35% 0.02 80)"/>
          <path d="M150.79 273.8 258.56 211.64 258.56 211.59 258.56 62.31 218.09 38.91 218.09 188.24 150.79 227.09 150.79 273.8Z" fill="oklch(35% 0.02 80)"/>
        </g>
        <text x="160" y="48" text-anchor="middle" font-size="12" font-weight="700" fill="oklch(30% 0.02 80)">HashiCorp Vault</text>

        <!-- AAP Zone -->
        <rect x="340" y="15" width="280" height="540" rx="16" fill="oklch(96.5% 0.01 10)" stroke="oklch(85% 0.015 10)" stroke-width="1.5"/>
        <!-- Red Hat icon (above title) -->
        <g transform="translate(470, 20) scale(0.07)">
          <path d="m 128,84 c 12.5,0 30.6,-2.6 30.6,-17.5 a 19.53,19.53 0 0 0 -0.3,-3.4 L 150.9,30.7 C 149.2,23.6 147.7,20.3 135.2,14.1 125.5,9.1 104.4,1 98.1,1 92.2,1 90.5,8.5 83.6,8.5 76.9,8.5 72,2.9 65.7,2.9 c -6,0 -9.9,4.1 -12.9,12.5 0,0 -8.4,23.7 -9.5,27.2 a 6.15,6.15 0 0 0 -0.2,1.9 C 43,53.7 79.3,83.9 128,84 m 32.5,-11.4 c 1.7,8.2 1.7,9.1 1.7,10.1 0,14 -15.7,21.8 -36.4,21.8 C 79,104.5 38.1,77.1 38.1,59 a 18.35,18.35 0 0 1 1.5,-7.3 C 22.8,52.5 1,55.5 1,74.7 1,106.2 75.6,145 134.6,145 c 45.3,0 56.7,-20.5 56.7,-36.7 0,-12.7 -11,-27.1 -30.8,-35.7" fill="#ee0000"/>
        </g>
        <text x="480" y="48" text-anchor="middle" font-size="12" font-weight="700" fill="oklch(30% 0.015 10)">Ansible Automation Platform</text>

        <!-- Target Hosts Zone (no box, no label — boxes stand on their own) -->

        <!-- Authentication & Credentials — inside platform boxes at bottom -->
        <!-- Authentication (Vault column — bottom of box) -->
        <rect x="45" y="480" width="230" height="55" rx="10" fill="white" stroke="oklch(82% 0.02 80)" stroke-width="1.2" filter="url(#shadow)"/>
        <text x="72" y="507" font-size="13" font-weight="700" fill="oklch(25% 0.01 55)">Authentication</text>
        <text x="72" y="522" font-size="10.5" fill="oklch(50% 0.01 55)">AppRole &amp; identity-based access</text>
        <rect x="55" y="495" width="8" height="8" rx="2" fill="#B28600"/>

        <!-- Credentials (AAP column — bottom of box, aligned) -->
        <rect x="365" y="480" width="230" height="55" rx="10" fill="white" stroke="oklch(82% 0.015 10)" stroke-width="1.2" filter="url(#shadow)"/>
        <text x="392" y="507" font-size="13" font-weight="700" fill="oklch(25% 0.01 55)">Credentials</text>
        <text x="392" y="522" font-size="10.5" fill="oklch(50% 0.01 55)">identity-based Vault auth</text>
        <rect x="375" y="495" width="8" height="8" rx="2" fill="#B28600"/>

        <!-- ══════ PHASE 1: Monitor & Check ══════ -->
        <g class="arch-monitor">
          <!-- Certificates Inventory -->
          <rect x="45" y="75" width="230" height="80" rx="10" fill="white" stroke="#009D9A" stroke-width="2" filter="url(#shadow)"/>
          <text x="72" y="105" font-size="13" font-weight="700" fill="oklch(25% 0.01 55)">Certificates Inventory</text>
          <text x="72" y="120" font-size="10.5" fill="oklch(50% 0.01 55)">Expiry tracking &amp; reporting</text>
          <text x="72" y="140" font-size="9" font-weight="600" fill="#009D9A">&#x2713; Fully automated fleet visibility</text>
          <rect x="55" y="93" width="8" height="8" rx="2" fill="#009D9A"/>

          <!-- Auto-Tidy (below Cert Inventory, aligned with CLM Renewal Targets) -->
          <rect x="45" y="190" width="230" height="65" rx="10" fill="white" stroke="oklch(82% 0.02 80)" stroke-width="1.2" filter="url(#shadow)"/>
          <text x="72" y="214" font-size="13" font-weight="700" fill="oklch(25% 0.01 55)">Auto-Tidy</text>
          <text x="72" y="229" font-size="10.5" fill="oklch(50% 0.01 55)">Cleans expired/revoked certs every 24h</text>
          <text x="72" y="244" font-size="9" font-weight="600" fill="#DA1E28">&#x2713; Self-maintaining PKI hygiene</text>
          <rect x="55" y="202" width="8" height="8" rx="2" fill="#DA1E28"/>

          <!-- 1. Daily Renewal Check -->
          <rect x="365" y="75" width="230" height="70" rx="10" fill="white" stroke="oklch(82% 0.015 10)" stroke-width="1.2" filter="url(#shadow)"/>
          <text x="392" y="100" font-size="12" font-weight="700" fill="oklch(25% 0.01 55)">1. Daily Renewal Check</text>
          <text x="392" y="115" font-size="10.5" fill="oklch(50% 0.01 55)">Query inventory API &rarr; find</text>
          <text x="392" y="128" font-size="10.5" fill="oklch(50% 0.01 55)">expiring certs &rarr; populate targets</text>
          <rect x="375" y="88" width="8" height="8" rx="2" fill="#009D9A"/>

          <!-- CLM Renewal Targets (fully automated dynamic inventory) -->
          <rect x="365" y="190" width="230" height="65" rx="10" fill="white" stroke="#EE0000" stroke-width="2" filter="url(#shadow)"/>
          <text x="392" y="214" font-size="13" font-weight="700" fill="oklch(25% 0.01 55)">CLM Renewal Targets</text>
          <text x="392" y="229" font-size="10.5" fill="oklch(50% 0.01 55)">Auto-populated &mdash; zero human input</text>
          <text x="392" y="244" font-size="9" font-weight="600" fill="#EE0000">&#x2713; Fully automated dynamic inventory</text>
          <rect x="375" y="202" width="8" height="8" rx="2" fill="#EE0000"/>

          <!-- Daily Check → Cert Inventory (query expiry) -->
          <path d="M 363 110 H 277" fill="none" stroke="#009D9A" stroke-width="1.8" marker-end="url(#arrowTeal)"/>
          <text x="320" y="103" font-size="9" fill="#009D9A" text-anchor="middle">query expiry</text>

          <!-- Daily Check → Renewal Targets -->
          <path d="M 480 147 V 188" fill="none" stroke="#EE0000" stroke-width="1.8" marker-end="url(#arrowRed)"/>
          <text x="487" y="172" font-size="9" fill="#EE0000">populate</text>

        </g>

        <!-- ══════ PHASE 2: Issue, Deploy & Verify ══════ -->
        <g class="arch-deploy">
          <!-- PKI Secrets Engine -->
          <rect x="45" y="200" width="230" height="70" rx="10" fill="white" stroke="oklch(82% 0.02 80)" stroke-width="1.2" filter="url(#shadow)"/>
          <text x="72" y="230" font-size="13" font-weight="700" fill="oklch(25% 0.01 55)">PKI Secrets Engine</text>
          <text x="72" y="247" font-size="10.5" fill="oklch(50% 0.01 55)">issuing-ca / server-certs role</text>
          <rect x="55" y="218" width="8" height="8" rx="2" fill="#FFD814"/>

          <!-- 2. Issue, Deploy & Verify -->
          <rect x="365" y="290" width="230" height="140" rx="10" fill="white" stroke="oklch(82% 0.015 10)" stroke-width="1.2" filter="url(#shadow)"/>
          <text x="392" y="315" font-size="12" font-weight="700" fill="oklch(25% 0.01 55)">2. Issue, Deploy &amp; Verify</text>
          <g font-size="10.5" fill="oklch(40% 0.01 55)">
            <circle cx="385" cy="335" r="3.5" fill="#0F62FE"/>  <text x="394" y="338">Issue cert from Vault PKI</text>
            <circle cx="385" cy="353" r="3.5" fill="#198038"/>  <text x="394" y="356">Backup existing cert</text>
            <circle cx="385" cy="371" r="3.5" fill="#B28600"/>  <text x="394" y="374">Deploy &amp; reload service</text>
            <circle cx="385" cy="389" r="3.5" fill="#009D9A"/>  <text x="394" y="392">Verify TLS handshake</text>
            <circle cx="385" cy="407" r="3.5" fill="#DA1E28"/>  <text x="394" y="410">Rollback on failure</text>
          </g>

          <!-- Target Host boxes (sequential build: issue → backup → deploy → verify) -->
          <g class="arch-deploy-line" data-step="1">
            <rect x="685" y="75" width="230" height="70" rx="10" fill="white" stroke="oklch(82% 0.01 240)" stroke-width="1.2" filter="url(#shadow)"/>
            <text x="712" y="102" font-size="13" font-weight="700" fill="oklch(25% 0.01 55)">Web Servers</text>
            <text x="712" y="119" font-size="10.5" fill="oklch(50% 0.01 55)">PEM cert + key + fullchain</text>
            <rect x="695" y="90" width="8" height="8" rx="2" fill="#0F62FE"/>
          </g>

          <g class="arch-deploy-line" data-step="2">
            <rect x="685" y="200" width="230" height="55" rx="10" fill="white" stroke="oklch(82% 0.01 240)" stroke-width="1.2" filter="url(#shadow)"/>
            <text x="712" y="227" font-size="13" font-weight="700" fill="oklch(25% 0.01 55)">Certificate Backups</text>
            <text x="712" y="242" font-size="10.5" fill="oklch(50% 0.01 55)">Timestamped backup with retention</text>
            <rect x="695" y="215" width="8" height="8" rx="2" fill="#198038"/>
          </g>

          <g class="arch-deploy-line" data-step="3">
            <rect x="685" y="310" width="230" height="55" rx="10" fill="white" stroke="oklch(82% 0.01 240)" stroke-width="1.2" filter="url(#shadow)"/>
            <text x="712" y="337" font-size="13" font-weight="700" fill="oklch(25% 0.01 55)">SSL Configuration</text>
            <text x="712" y="352" font-size="10.5" fill="oklch(50% 0.01 55)">Service-specific TLS settings</text>
            <rect x="695" y="325" width="8" height="8" rx="2" fill="#B28600"/>
          </g>

          <g class="arch-deploy-line" data-step="4">
            <rect x="685" y="420" width="230" height="55" rx="10" fill="white" stroke="oklch(82% 0.01 240)" stroke-width="1.2" filter="url(#shadow)"/>
            <text x="712" y="447" font-size="13" font-weight="700" fill="oklch(25% 0.01 55)">TLS Verification</text>
            <text x="712" y="462" font-size="10.5" fill="oklch(50% 0.01 55)">openssl s_client + HTTPS check</text>
            <rect x="695" y="435" width="8" height="8" rx="2" fill="#009D9A"/>
          </g>

          <!-- Issue/Deploy → PKI Engine -->
          <path id="archPathLeft" d="M 365 335 H 333 Q 325 335 325 327 V 243 Q 325 235 317 235 H 277" fill="none" stroke="#0F62FE" stroke-width="2" marker-end="url(#arrowBlue)"/>
          <text x="362" y="329" font-size="9" fill="#0F62FE" text-anchor="end">issue</text>

          <!-- Credentials → Authentication (horizontal, both at y=507) -->
          <path d="M 365 507 H 277" fill="none" stroke="#B28600" stroke-width="1.8" marker-end="url(#arrowGold)"/>
          <text x="320" y="500" font-size="9" fill="#B28600" text-anchor="middle">auth</text>

          <!-- Right-side connections (sequential: 1.issue → 2.backup → 3.deploy → 4.verify) -->
          <g class="arch-deploy-line" data-step="1">
            <path id="archPathR1" d="M 595 335 H 617 Q 625 335 625 327 V 118 Q 625 110 633 110 H 683" fill="none" stroke="#0F62FE" stroke-width="2" marker-end="url(#arrowBlue)"/>
            <text x="658" y="103" font-size="8.5" fill="#0F62FE" font-weight="600" text-anchor="middle">1. issue</text>
          </g>

          <g class="arch-deploy-line" data-step="2">
            <path id="archPathR2" d="M 595 353 H 630 Q 638 353 638 345 V 235 Q 638 227 646 227 H 683" fill="none" stroke="#198038" stroke-width="1.5" marker-end="url(#arrowGreen)"/>
            <text x="664" y="220" font-size="8.5" fill="#198038" font-weight="600" text-anchor="middle">2. backup</text>
          </g>

          <g class="arch-deploy-line" data-step="3">
            <path id="archPathR3" d="M 595 371 H 642 Q 650 371 650 363 V 345 Q 650 337 658 337 H 683" fill="none" stroke="#B28600" stroke-width="1.5" marker-end="url(#arrowGold)"/>
            <text x="670" y="330" font-size="8.5" fill="#B28600" font-weight="600" text-anchor="middle">3. deploy</text>
          </g>

          <g class="arch-deploy-line" data-step="4">
            <path id="archPathR4" d="M 595 389 H 617 Q 625 389 625 397 V 439 Q 625 447 633 447 H 683" fill="none" stroke="#009D9A" stroke-width="1.5" marker-end="url(#arrowTeal)"/>
            <text x="658" y="440" font-size="8.5" fill="#009D9A" font-weight="600" text-anchor="middle">4. verify</text>
          </g>
        </g>

        <!-- Flow ball -->
        <circle id="archFlowBall" class="arch-flow-ball" r="5" fill="#0F62FE" cx="0" cy="0"/>

      </svg>
    </div>
  </div>
</section>
